#!/bin/bash
# Kiosk control script - manages display power, URL navigation, and browser refresh for kiosk mode

# Configuration file path
CFG="$HOME/.kiosk.cfg"

# Validate configuration file exists before sourcing
if [[ ! -f "${CFG}" ]]; then
    echo "ERROR: Configuration file not found at ${CFG}" >&2
    echo "Please copy .kiosk.cfg to your home directory" >&2
    exit 1
fi

# Source configuration file
source "${CFG}"

# Verify required variables are set
if [[ -z "${URLFILE}" ]] || [[ -z "${RUNFILE}" ]] || [[ -z "${PWRMODE}" ]]; then
    echo "ERROR: Required configuration variables not set in ${CFG}" >&2
    exit 1
fi

# Get current refresh setting
CURRENT_REFRESH=$(grep -i "^REFRESH=" "${CFG}" | sed 's/^REFRESH=//')

# Parse command-line argument
if [[ -z "$1" ]]; then
    echo
    echo "You didn't add any arguments. Try adding -help"
    echo
    exit 1
else
    USER_COMMAND=$(echo "$1" | tr '[:upper:]' '[:lower:]')
fi

# Navigate to URL by opening in new tab and closing the old one
# This prevents tab accumulation in kiosk mode
send_url() {
    export DISPLAY=:0.0
    # Open new tab
    xdotool key ctrl+t
    sleep 0.3
    # Type URL in the new tab
    xdotool type "$1"
    sleep 0.2
    xdotool key Return
    sleep 0.5
    # Switch to the first tab (the old one) and close it
    xdotool key ctrl+1
    sleep 0.2
    xdotool key ctrl+w
}

# Display all available URL shortcuts from the configuration file
# Format: Short Name | Description | URL
list_shortnames() {
    echo
    printf "%-3s %-20s %-40s %-40s \n" " " "Short Name" "Description" "URL"
    printf "%-3s %-20s %-40s %-40s \n" " " "---------------" "-----------------------------------" "-----------------------------------------------------------------"
    while IFS="," read -r shortname description url; do
        printf "%-3s %-20s %-40s %-40s \n" " " "${shortname}" "${description}" "${url}"
    done < <(grep -v "#" "${URLFILE}")
    echo
}

# Control HDMI display power output with override capability
# Can be overridden by .powermode file in home directory
screen_power() {
    local power_mode=""
    if [[ -f "${PWRMODE}" ]]; then
        power_mode=$(cat "${PWRMODE}")
    fi

    if [[ "$1" == "off" ]]; then
        if [[ "${power_mode}" == "stayon" ]]; then
            echo "Powermode Override is set to: STAY ON"
            exit 0
        else
            /usr/bin/vcgencmd display_power 0 > /dev/null 2>&1
        fi
    elif [[ "$1" == "on" ]]; then
        if [[ "${power_mode}" == "stayoff" ]]; then
            echo "Powermode Override is set to: STAY OFF"
            exit 0
        else
            /usr/bin/vcgencmd display_power 1 > /dev/null 2>&1
        fi
    fi
}

# Refresh the browser immediately using Ctrl+F5 if xdotool is available
refresh_now() {
    local xdotool_path
    xdotool_path=$(which xdotool)

    if [[ -z "${xdotool_path}" ]]; then
        echo
        echo "ERROR: 'xdotool' not found - please install it:"
        echo "  sudo apt-get -y install xdotool"
        echo
        return 1
    else
        export DISPLAY=:0.0
        xdotool key ctrl+F5 &
    fi
}

case "${USER_COMMAND}" in
	refresh|reload|f5)
		if [[ -z "$2" ]]; then
			refresh_now
		else
			# Set new refresh rate in config file
			local new_refresh="$2"
			if [[ -z "${RUNFILE}" ]] || [[ ! -f "${RUNFILE}" ]]; then
				echo "ERROR: Cannot find PID file ${RUNFILE}" >&2
				exit 1
			fi
			sed -i.bak "s/^REFRESH=.*/REFRESH=${new_refresh}/g" "${CFG}"
			echo
			echo "Changed REFRESH from ${CURRENT_REFRESH} seconds to ${new_refresh} seconds"
			echo
			local pid
			pid=$(cat "${RUNFILE}")
			if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
				kill -HUP "${pid}" 2>/dev/null || true
			else
				echo "Warning: Could not signal kiosk process"
			fi
		fi
	;;
	off)
		# Turn off the HDMI display
		screen_power off
	;;
	on)
		# Turn on the HDMI display
		screen_power on
	;;
	list)
		# List all available URL shortcuts
		list_shortnames
	;;
	help|-help|--help|-h)
		# Show the help screen
		echo
		echo "There are 2 commands plus a list of short names you can use to control this script"
		echo
		printf "%-3s %-20s %-40s \n" " " "Command" "Description"
		printf "%-3s %-20s %-40s \n" " " "---------------" "-----------------------------------"
		printf "%-3s %-20s %-40s \n" " " "On" "This will turn ON the screen"
		printf "%-3s %-20s %-40s \n" " " "Off" "This will turn OFF the screen"
		printf "%-3s %-20s %-40s \n" " " "" "Screen power override can be made by creating a file called \`.powermode\` in your home directory."
		printf "%-3s %-20s %-40s \n" " " "" "If the first line is just \`stayon\` or \`stayoff\` then the above cmds will respect this file."
		printf "%-3s %-20s %-40s \n" " " "" "If the file \`.powermode\` doesn't exist then off / on commands work as expected."
		echo
		printf "%-3s %-20s %-40s \n" " " "Refresh" "Refreshes the browser"
		printf "%-3s %-20s %-40s \n" " " "Refresh ###" "Provide a number to change refresh time period (Current refresh rate: ${CURRENT_REFRESH})"
		printf "%-3s %-20s %-40s \n" " " "Help" "Prints this help screen"
		echo
		list_shortnames
	;;
	*)
		# Handle URL shortcuts or direct URL input
		# If argument starts with 'http', treat as direct URL
		# Otherwise, look up in URLFILE by shortname

		if [[ "${USER_COMMAND}" =~ ^https?:// ]]; then
			# Direct URL provided - navigate to it
			send_url "${USER_COMMAND}" > /dev/null 2>&1
		else
			# Check if URLFILE exists
			if [[ ! -f "${URLFILE}" ]]; then
				echo "ERROR: URL file not found at ${URLFILE}" >&2
				exit 1
			fi

			# Look up shortname in URLFILE
			if ! grep -qi "^${USER_COMMAND}," "${URLFILE}"; then
				echo
				echo "Unknown shortname: ${USER_COMMAND}"
				echo "Here are the available shortcuts:"
				echo
				list_shortnames
				exit 255
			else
				# Extract and navigate to URL for matched shortname
				while IFS="," read -r shortname description url; do
					send_url "${url}" > /dev/null 2>&1
				done < <(grep -i "^${USER_COMMAND}," "${URLFILE}")
			fi
		fi
	;;
esac

#end
